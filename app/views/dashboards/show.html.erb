<%= javascript_include_tag "https://www.gstatic.com/charts/loader.js" %>
<style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
</style>
<body class="flex bg-gray-100 min-h-screen mt-6 mb-6 text-white ">        
    <main class="p-6 sm:p-10 space-y-6">
      <div class="flex flex-col space-y-6 md:space-y-0 md:flex-row justify-between">
        <div class="mr-6">
          <h1 class="text-4xl font-semibold mb-2 text-white"><%= t('.title') %></h1>
        </div>
      <div class="flex items-start justify-end -mb-3">
          <%= link_to movies_search_path, class: "inline-flex items-center justify-center text-center px-3 py-3 text-purple bg-white hover:bg-purple-700 focus:bg-purple-700 rounded-md ml-6 mb-3 no-underline text-sm shadow-lg shadow-violet-300" do %>       
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="flex-shrink-0 h-5 w-5 -ml-1 mt-0.5 mr-2 ">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
              <%= t('.record_movie') %>
            <% end %>

          <%= link_to weight_logs_path, class: "text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md ml-6 mb-3 no-underline text-sm shadow-lg shadow-violet-300" do %>
          <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="flex-shrink-0 h-5 w-5 -ml-1 mt-0.5 mr-2">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
           </svg>
          <%= t('.record_weight') %>
          <% end %>
          </div>
        </div>
      <section class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">
      
        <div class="flex items-center p-8 text-white border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300">
          <div class="inline-flex flex-shrink-0 items-center justify-center h-16 w-16 text-purple-600 bg-purple-200 rounded-full mr-6  shadow-lg shadow-violet-200">
           <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="h-6 w-6" style="filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0 1 18 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0 1 18 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 0 1 6 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125M18 18.375v-5.25m0 5.25v-1.5c0-.621.504-1.125 1.125-1.125M18 13.125v1.5c0 .621.504 1.125 1.125 1.125M18 13.125c0-.621.504-1.125 1.125-1.125M6 13.125v1.5c0 .621-.504 1.125-1.125 1.125M6 13.125C6 12.504 5.496 12 4.875 12m-1.5 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M19.125 12h1.5m0 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h1.5m14.25 0h1.5" />
            </svg> 
          </div>
          <div>
            <span class="block text-2xl font-bold"><%= @movie_histories.size %> <%= t('.total_count') %></span>
            <span class="block text-gray-500"><%= t('.total_watched_movies') %></span>
          </div>
        </div>
        
          <div class="flex items-center p-8 text-white border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300">
          <div class="inline-flex flex-shrink-0 items-center justify-center h-16 w-16 text-teal-600 bg-teal-100 rounded-full mr-6 shadow-lg  shadow-teal-300">
          <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="h-6 w-6" style="filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
</div>
          <div>
            <span class="block text-2xl font-bold"> 
              <% if current_user.remaining_runtime %>
                <%= current_user.remaining_runtime.round %> 
                <%= t('.hours') %>
              <% else %>
               <%= t('.zero_hours') %>
              <% end %>
            </span>
            <span class="block text-gray-500"><%= t('.target_movie_runtime') %></span>
          </div>
        </div>
        <div class="flex items-center p-8 text-white border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300">
          <div class="inline-flex flex-shrink-0 items-center justify-center h-16 w-16 text-blue-600 bg-blue-100 rounded-full mr-6  shadow-lg shadow-blue-300">
           <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="h-6 w-6" style="filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));">       
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z" />
            </svg>
          </div>
      <div>
      
        <% if @weight_logs.present? %>
        <span class="block text-2xl font-bold"><%= @weight_logs.last[1] %> kg</span>
        <% else %>
        <span class="block text-2xl font-bold"><%= t('.no_record') %></span>
        <% end %>
        <span class="block text-gray-500"><%= t('.current_weight') %></span>
      </div>
    </div>

    <div class="flex items-center p-8 text-white border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300">
          <div class="inline-flex flex-shrink-0 items-center justify-center h-16 w-16 text-yellow-600 text-bold bg-yellow-100 rounded-full mr-6  shadow-lg shadow-yellow-300">
            <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="h-6 w-6" style="filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));">         
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
            </svg>
          </div>
          <div>
       <span class="block text-2xl font-bold"><%= current_user.target_weight %> kg</span>
            <span class="block text-gray-500"><%= t('.target_weight') %></span>
          </div>      
        </div>
      </section>

      <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 xl:grid-rows-3 xl:grid-flow-col mt-8 ">
        <div class="flex flex-col md:col-span-2 md:row-span-2 text-white border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300">
          <div class="px-6 py-3 font-semibold border-b border-gray-100 mt-2"><%= t('.weight_log') %></div>
            <div class="p-4 flex-grow">
              <div class="p-4 flex-grow rounded-md">  
              <%= line_chart @weight_logs.map { |created_at, weight| { created_at.strftime("%m月%d日") => weight } }.inject(:merge),
                  label: "体重(kg)",
                  height: "900px",
                  width: "100%",
                  library: {
                  xtitle: "日付",
                  ytitle: "体重",
                  backgroundColor: 'transparent',
                  chartArea: { backgroundColor: 'transparent', width: '80%', height: '80%' },
                  vAxis: {
                    viewWindow: {
                      min: @min_weight,
                      max: @max_weight
                    },
                    textStyle: { color: '#ffffff' }
                    },
                  hAxis: {
                    textStyle: { color: '#ffffff'}
                  },
                  crosshair: { 
                    focused: { color: '#3bc', opacity: 0.8 } 
                  },
                  series: { 0 => { color: '#9f44ee', enableInteractivity: true, pointSize: 8, pointShape: 'circle', lineWidth: 3, pointsVisible: true } }
                   } %>
              </div>
            </div> 
          </div>
                
  <div class="flex flex-col md:col-span-2 md:row-span-2 text-white text-base border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300 h-[50%]">
    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-8 font-semibold border-b border-gray-100">
      <span class="w-full sm:w-auto text-center sm:text-left mb-4 sm:mb-0">
        <%= t('.watched_movie') %>
        <%= t('.total') %>
        <%= @total_watched_runtime %>
        <%= t('.hours') %>
      </span>
      <span class="w-full sm:w-auto text-center sm:text-left">
        <%= t('.watched_calorie') %> =
        <%= @total_watched_calorie %> kcal
      </span>
    </div>


  
    <div class="overflow-auto no-scrollbar" style="height:390px;">
      <ul>
        <% if @movie_histories.present? %>
          <% @movie_histories.each do |history| %>
          <li class="flex items-center justify-between px-6 py-2">
            <div class="flex flex-col">
              <span class="font-medium text-white"><%= history.title %></span>
              <span class="text-sm text-gray-500">(<%= history.runtime %>分)</span>
            </div>
            <%= button_to movie_history_path(history), method: :delete, remote: true, class: "btn btn-danger flex items-center" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </li>
        <% end %>
      <% else %>
        <p class="px-6 py-2"><%= t('.no_record') %></p>
      <% end %>
    </ul>
  </div>
</div>
</div>
</body>      
</section> 
</main>  
 