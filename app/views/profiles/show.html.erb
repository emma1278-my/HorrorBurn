<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="max-w-4xl my-10 p-8 mx-auto border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
  <div class="text-center">
    <% unless current_user.guest? %>
      <%= link_to t('defaults.edit'), edit_profile_path, class: 'btn btn-primary float-right shadow-lg rounded-lg bg-violet-500 hover:bg-violet-600' %>
    <% end %>
    <div class="relative my-10 max-w-sm mx-auto">
      <div class="rounded overflow-hidden">
        <div class="w-full flex justify-center">
          <div class="h-32 w-32">
          <% if current_user.guest? %>
           <%= image_tag 'guest_icon.png', class: 'rounded-full', width: '100', height: '100' %>
           <% else %>
            <%= image_tag current_user.avatar_url, class: 'rounded-full', width: '100', height: '100' %>
          <% end %>
          </div>
        </div>
        <div class="mt-4 text-xl text-center">
          <p><%= current_user.name %></p>
          <p><%= current_user.email %></p>
        </div>
      </div>
    </div>
  </div>
</section>
<% unless current_user.guest? %>
<div class="p-8 max-w-4xl mx-auto my-10">
     <%= link_to 'passwordを変更する', new_password_reset_path, class: "rounded-full bg-pink-500 active:bg-violet-600  hover:bg-violet-700 py-1 px-5 text-white float-right shadow-lg rounded-lg shadow-violet-300 items-right no-underline" %>

      <%= link_to "退会希望の方はこちら", users_withdraw_path, method: :patch, class: "text-white dark:text-gray-400 hover:underline  rounded-full bg-blue-500 active:bg-violet-600  hover:bg-violet-700 py-1 px-5 text-white  shadow-lg rounded-lg shadow-violet-300 no-underline", data: { confirm: "本当に退会しますか？" } %>
</div>
<% end %>
 