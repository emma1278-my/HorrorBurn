<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="max-w-4xl my-10 p-8 mx-auto border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
  <div class="text-center">
    <% unless current_user.guest? %>
      <%= link_to t('defaults.edit'), edit_profile_path, class: 'btn btn-primary float-right shadow-lg rounded-lg bg-violet-500 hover:bg-violet-600' %>
    <% end %>
    <div class="relative my-10 max-w-sm mx-auto">
      <div class="rounded overflow-hidden">
        <div class="w-full flex justify-center">
          <div class="h-32 w-32">
          <% if current_user.guest? %>
           <%= image_tag 'guset.png', class: 'item-center justyfy-center rounded-full', width: '125', height: '125' %>
           <% else %>
            <%= image_tag current_user.avatar_url, class: 'item-center rounded-full', width: '125', height: '125' %>
          <% end %>
          </div>
        </div>
        <div class="mt-8 text-xl justyfy-center text-center">
          <p><%= current_user.name %></p>
          <p><%= current_user.email %></p>
        </div>
      </div>
    </div>
  </div>
</section>
<% unless current_user.guest? %>
<div class="p-8 max-w-4xl mx-auto my-10">
     <%= link_to t('.reset_password'), new_password_reset_path, class: "rounded-full bg-neon-yellow active:bg-violet-600  hover:bg-violet-700 py-1 px-5 text-black float-right shadow-lg rounded-lg shadow-violet-300 items-right no-underline" %>


      <%= link_to t('.delete_account'), user_path(current_user), data: { turbo_method: :delete, turbo_confirm: '本当に退会しますか？'}, class: "text-white dark:text-gray-400 hover:underline  rounded-full bg-blue-500 active:bg-violet-600  hover:bg-violet-700 py-1 px-5 text-white  shadow-lg rounded-lg shadow-violet-300 no-underline" %>
</div>
<% end %>
 