<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="max-w-4xl my-10 p-8 mx-auto border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
  <div class="text-center">
    
    <div class="relative my-10 max-w-sm mx-auto">
  <div class="rounded overflow-hidden">
    <div class="w-full flex justify-center">
      <div class="h-32 w-32">
        <% if current_user.guest? %>
          <%= image_tag 'guset.png', class: 'item-center justyfy-center rounded-full', width: '125', height: '125' %>
        <% else %>
          <%= image_tag current_user.avatar_url, class: 'item-center rounded-full', width: '125', height: '125' %>
        <% end %>
      </div>
    </div>
    <div class="mt-8 text-xl flex flex-col items-center justify-center">
      <p><%= current_user.name %></p>
      <p><%= current_user.email %></p>
      <% unless current_user.guest? %>
      <%= link_to t('defaults.edit'), edit_profile_path, class: 'text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md mt-3 no-underline text-sm shadow-lg shadow-violet-300 mb-6' %>
    <% end %>
  </div>
  </div>
</div>
</section>
<% unless current_user.guest? %>
<div class="p-8 max-w-4xl mx-auto my-10">
    <%= link_to t('.delete_account'), user_path(current_user), data: { turbo_method: :delete, turbo_confirm: '本当に退会しますか？'}, class: "rounded-full bg-neon-yellow active:bg-violet-600  hover:bg-violet-700 py-1 px-5 text-black float-right shadow-lg rounded-md shadow-violet-300 items-right no-underline" %>
</div>
<% end %>
 