<section class="p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
<h1 class="text-lg mb-5"><%= t('.title') %></h1>

<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto text-black">
      <%= form_with model: @user, url: profile_path, method: :put do |f| %>
      <%= render 'shared/error_messages', object: f.object %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="mt-5 mb-3">
          <%= f.label :avatar %>
          <%= f.file_field :avatar, class: 'form-control mb-3', accept: 'image/*' %>
          <%= f.hidden_field :avatar_cache %>
          <div class="mt-5 mb-3">
            <%= image_tag @user.avatar.url, class: 'rounded-full', id: 'preview', width: '150', height: '150' %>
          </div> 
          <div class="mt-5 mb-5">
          <%= f.submit class: "btn btn-9 float-left shadow-lg rounded-lg shadow-violet-300" %>
          </div>
        </div>  
       
      <% end %>
      <div class='text-center'>
        <%= link_to t('.to_login_page'), login_path %>
      </div>
    </div>
  </div>
</div>
</section>