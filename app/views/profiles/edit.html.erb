<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
 <div class="container d-flex justify-content-center align-items-center min-vh-100">
  <div class="row">
    <div class="col-md-10 col-lg-8 text-white text-center mx-auto">
      <%= form_with model: @user, url: profile_path, method: :put, local: true, html: { class: 'needs-validation', novalidate: '' } do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label text-center" %>
          <%= f.email_field :email, class: "form-control", placeholder: "Enter email" %>
        </div>
        <div class="mb-3">
          <%= f.label :name, class: "form-label text-center" %>
          <%= f.text_field :name, class: "form-control", placeholder: "Enter name" %>
        </div>
        <div class="mb-3 text-center">
          <%= f.label :avatar, class: "form-label" %>
          <%= f.file_field :avatar, class: 'form-control', accept: 'image/*' %>
          <%= f.hidden_field :avatar_cache %>
        </div>
        <div class="mb-3 text-center">
          <%= image_tag @user.avatar.url, class: 'rounded-full', id: 'preview', width: '150', height: '150' %>
        </div>
        <div class="text-center">
          <%= f.submit t('.submit'), class: "btn btn-primary shadow-lg rounded-lg bg-violet-500 hover:bg-violet-600" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</section>