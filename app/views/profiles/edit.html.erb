<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="flex justify-center items-center p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
  <%= form_with model: @user, url: profile_path, method: :put, local: true, html: { class: 'needs-validation w-full max-w-md', novalidate: '' } do |f| %>
    <%= render 'shared/error_messages', object: f.object %>

    <div class="mb-4 ">
      <%= f.label :email, class: "block text-sm font-medium text-white" %>
      <%= f.email_field :email, class: "form-input mt-1 block w-full rounded-md bg-white placeholder-gray-400 shadow-sm focus:bg-white/30 focus:ring-violet-500 focus:border-violet-500 sm:text-sm", placeholder: "Enter email" %>
    </div>
    <div class="mb-4 ">
       <%= f.label :name, class: "block text-sm font-medium text-white" %>
      <%= f.text_field :name, class: "form-input mt-1 block w-full rounded-md bg-white  placeholder-gray-400 shadow-sm focus:bg-white/30 focus:ring-violet-500 focus:border-violet-500 sm:text-sm", placeholder: "Enter name" %>
    </div>
    <div>
    </div>
       <div class="mb-4">
      <%= f.label :avatar, class: "form-label block" %>
      <%= f.file_field :avatar, class: 'form-control rounded-md mx-auto', accept: 'image/*' %>
      <%= f.hidden_field :avatar_cache %>
    </div>
    <div class="mb-4 text-center">
      <%= image_tag @user.avatar.url, class: 'rounded-full mx-auto', id: 'preview', width: '125', height: '125' %>
    </div>
    <div class="text-center">
      <%= f.submit t('.submit'), class: 'text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md mt-3 no-underline text-sm' %>
    </div>
  <% end %>
</section>