<section class="relative justify-center p-4 md:p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300">
  <div class="container mx-auto px-4 py-12 sm:py-16 lg:py-20">
    <div class="text-center">
      <p class="text-3xl font-extrabold tracking-tight text-white lg:text-5xl mb-8"><%= t('.title') %></p>
    </div>
    <div class="max-w-md mx-auto">
       <%= form_with model: @weight_log, url: weight_logs_path, data: { turbo: false }, html: { class: "flex flex-col sm:flex-row items-center justify-center " } do |f| %>
        <div class="relative flex-grow mb-2 sm:mb-0 sm:mr-0">
          <%= f.number_field :weight, step: 0.1, min: 30.0, max: 150.0, class: "block w-64 p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: t('.placeholder'), required: true %>
        </div>
        <button type="submit" class="btn btn-9 float-center rounded-lg shadow-violet-300-lg mt-6 mb-8 bg-violet-500">記 録</button>
      <% end %>
    </div>
</section>
