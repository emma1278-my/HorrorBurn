<!DOCTYPE html>
<html>
  <head>
    <title>HorrorBurn</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag('favicon.ico') %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
     <link href="https://use.fontawesome.com/releases/v6.5.2/css/all.css" rel="stylesheet" />
      
  <meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Horror Burn">
<meta name="twitter:description" content="ホラー映画視聴時の消費カロリーをお知らせ">
<meta name="twitter:image" content="<%= image_url 'xshare.png'%>">
<meta property="og:title" content="Horror Burn">
<meta property="og:url" content="https://horrorburn-1.onrender.com">
<meta property="og:image" content="<%= image_url 'xshare.png'%>">

  
  </head>
   <body class="flex flex-col min-h-screen  bg-zinc-900 bg-gradient-to-b from-violet-600/10 via-transparent">
   <% if logged_in? %>
      <%= render 'shared/header' %>
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>
    <%= render 'shared/flash_message' %>
    <div class="flex-grow">
    <%= yield %>
    </div> 
    <%= render 'shared/footer' %>
    
  </body>
</html>
