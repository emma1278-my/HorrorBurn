<div class="flex justify-center">
<div class="w-full max-w-md p-6 mt-10 bg-transform rounded-lg shadow-lg shadow-violet-300">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <%= form_with(model: @user, local: true, html: { class: 'card-body' }) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        
            <div >
                <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                    <h1 class="text-xl text-center font-bold leading-tight tracking-tight text-white md:text-2xl">
                        新規登録
                    </h1>
                        <div>
                        <%= f.label :name, class:"block mb-2 text-sm font-medium text-white" %>
                        <%= f.text_field :name, class:"bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", placeholder: "名前", required: true %>
                       </div>
                        <div>
                            <%= f.label :email, User.human_attribute_name(:email), class: "block mb-2 text-sm font-medium text-white" %>
                            <%= f.email_field :email, class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", placeholder: "example@domain.com" %>
                        </div>
                        <div>
                            <%= f.label :password, User.human_attribute_name(:password), class: "block mb-2 text-sm font-medium text-white" %>
                            <%= f.password_field :password, placeholder: "••••••••", class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", required: true %>
                        </div>
                        <div>
                        <%= f.label :password_confirmation, class: "block mb-2 text-sm font-medium text-white", required: true  %>
                        <%= f.password_field :password_confirmation, placeholder: "••••••••", class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", required: true %>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                </div>
                                <div class="ml-3 text-sm">
                                </div>
                            </div>
                        </div>
                        <div class="flex item-center items-center justify-center">
                        <%= f.submit (t 'defaults.register'), class: "float-center text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md  no-underline text-sm mr-4 relative z-10 border-none rounded-md  py-3 px-6 text-base font-medium focus:shadow-md w-1/2 transition duration-300 ease-in-out  hover:text-white active:top-[2px] shadow-violet-300 shadow-lg focus:outline-none focus:ring focus:ring-gray-300 focus:ring-opacity-50" %> 
                        </div>
                        <div class="relative flex items-center justify-center">
                        <hr class="flex-grow border-gray-400">
                        <span class="relative px-4 text-sm text-gray-400 bg-transparent">または</span>
                        <hr class="flex-grow border-gray-400">
                        </div>
                        <div class="relative flex items-center justify-center">
                         <button class="flex items-center justify-center w-full px-6 py-2 mx-9 text-sm font-medium text-white transition-colors duration-300 transform bg-blue-500 rounded-lg hover:bg-blue-400 focus:bg-blue-400 focus:outline-none shadow-blue-300 shadow-lg">
                          <%= link_to "Googleアカウントでログイン", auth_at_provider_path(provider: :google), class: "text-white no-underline inline-block" %>
                        </button>
                        </div>
                        <div class="relative flex items-center justify-center">
                        <p class="text-sm !mt-10 text-center text-white">ログインは<%= link_to 'こちら', login_path, class: "text-blue-600 hover:underline ml-1 whitespace-nowrap" %></p>
                        </div>
                        <div class="relative flex items-center justify-center text-sm">
                        
                         <%= link_to "ゲストユーザーでお試し", guest_login_path, class: "text-white underline inline-block" %>

                         
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% end %>
</div>

