<div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <%= form_with(model: @user, local: true, html: { class: 'card-body' }) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        
            <div class="w-full rounded-lg dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700 bg-opacity-10 border-gray-400/30 backdrop-blur-lg shadow-lg shadow-violet-300">
                <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                    <h1 class="text-xl text-center font-bold leading-tight tracking-tight text-white md:text-2xl dark:text-white">
                        新規登録
                    </h1>
                        <div>
                        <%= f.label :name, class: "block mb-2 text-sm font-medium text-white" %>
                        <%= f.text_field :name, class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "名前", required: true %>
                       </div>
                        <div>
                            <%= f.label :email, User.human_attribute_name(:email), class: "block mb-2 text-sm font-medium text-white" %>
                            <%= f.email_field :email, class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "example@domain.com" %>
                        </div>
                        <div>
                            <%= f.label :password, User.human_attribute_name(:password), class: "block mb-2 text-sm font-medium text-white" %>
                            <%= f.password_field :password, placeholder: "••••••••", class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true %>
                        </div>
                        <div>
                        <%= f.label :password_confirmation, class: "block mb-2 text-sm font-medium text-white", required: true  %>
                        <%= f.password_field :password_confirmation, placeholder: "••••••••", class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true %>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                </div>
                                <div class="ml-3 text-sm">
                                </div>
                            </div>
                        </div>
                        <div class="flex item-center items-center justify-center">
                        <%= f.submit (t 'defaults.register'), class: "relative z-10 bg-[#b621fe] border-none rounded-md text-white py-3 px-6 text-base font-medium focus:shadow-md w-1/2 transition duration-300 ease-in-out hover:bg-[#663dff] hover:text-white active:top-[2px] shadow-violet-300 shadow-xl focus:outline-none focus:ring focus:ring-gray-300 focus:ring-opacity-50" %> 
                        </div>
                        <div class="relative flex items-center justify-center">
                          <span class="absolute inset-x-0 h-px bg-gray-300"></span>
                          <span class="relative px-4 text-sm text-gray-400 bg-zinc-900">または</span>
                        </div>
                        
                        <div class="relative flex items-center justify-center">
                         <button class="flex items-center justify-center w-full px-6 py-2 mx-9 text-sm font-medium text-white transition-colors duration-300 transform bg-blue-500 rounded-lg hover:bg-blue-400 focus:bg-blue-400 focus:outline-none shadow-blue-300 shadow-lg">
                          <%= link_to "Googleアカウントでログイン", auth_at_provider_path(provider: :google), class: "text-white no-underline inline-block" %>
                        </button>
                        </div>
                        <div class="relative flex items-center justify-center">
                         <%= link_to "ログイン", login_path, class: "text-white underline inline-block" %>
                        </div>
                        <div class="relative flex items-center justify-center">
                         <%= link_to "ゲストユーザーでお試し", guest_login_path, class: "text-white underline inline-block" %>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% end %>
</div>

