<div class="w-full max-w-sm p-6 m-auto mx-auto backdrop-blur-lg rounded-md border border-gray-200/30 mb-8 shadow-violet-300 shadow-2xl">
  
    <%= form_with(model: @user, local: true, html: { class: 'card-body' }) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <div>
            <label for="user_new" class="block text-lg text-white dark:text-gray-200 text-center font-bold">
                <span class="relative top-[-20px]">新規登録</span>
            </label>
            <%= f.label :name, class: "block text-sm text-white dark:text-gray-200" %>
            <%= f.text_field :name, class: "block w-full px-4 py-2 mt-2 text-gray-700 bg-white border rounded-lg dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 focus:border-blue-400 dark:focus:border-blue-300 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40", required: true %>
        </div>

        <div class="mt-4">
            <div class="flex flex-col">
                <%= f.label :email, User.human_attribute_name(:email), class: "block text-sm text-white dark:text-gray-200" %>
                <%= f.email_field :email, class: "block w-full px-4 py-2 mt-2 text-gray-700 bg-white border rounded-lg dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 focus:border-blue-400 dark:focus:border-blue-300 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40" %>
            </div>
        </div>

        <div class="mt-4">
            <div class="flex flex-col">
                <div class="flex justify-between items-center">
                    <%= f.label :password, User.human_attribute_name(:password), class: "block text-sm text-white dark:text-gray-200" %>   
                </div>
                <%= f.password_field :password, class: "block w-full px-4 py-2 mt-2 text-gray-700 bg-white border rounded-lg dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 focus:border-blue-400 dark:focus:border-blue-300 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40", required: true %>
            </div>
        </div>

        <div class="mt-4">
            <div class="flex flex-col">
                <%= f.label :password_confirmation, class: "block text-sm text-white dark:text-gray-200", required: true  %>
                <%= f.password_field :password_confirmation, class: "block w-full px-4 py-2 mt-2 text-gray-700 bg-white border rounded-lg dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 focus:border-blue-400 dark:focus:border-blue-300 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40" %>
            </div>
        </div>

        <div class="mt-6">
            <%= f.submit (t 'defaults.register'), class: "relative z-10 bg-[#b621fe] border-none rounded-md text-white py-3 px-6 text-base font-medium focus:shadow-md w-1/2 transition duration-300 ease-in-out hover:bg-[#663dff] hover:text-white active:top-[2px] shadow-violet-300 shadow-xl focus:outline-none focus:ring focus:ring-gray-300 focus:ring-opacity-50" %>  
        </div>
    <% end %> 

    <div class="mt-6">
        <button type="button" class="text-white bg-[#4285F4] hover:bg-[#4285F4]/90 focus:ring-4 focus:outline-none focus:ring-[#4285F4]/50 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:focus:ring-[#4285F4]/55 me-2 mb-2">
        <svg class="w-4 h-4 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 19">
        <path fill-rule="evenodd" d="M8.842 18.083a8.8 8.8 0 0 1-8.65-8.948 8.841 8.841 0 0 1 8.8-8.652h.153a8.464 8.464 0 0 1 5.7 2.257l-2.193 2.038A5.27 5.27 0 0 0 9.09 3.4a5.882 5.882 0 0 0-.2 11.76h.124a5.091 5.091 0 0 0 5.248-4.057L14.3 11H9V8h8.34c.066.543.095 1.09.088 1.636-.086 5.053-3.463 8.449-8.4 8.449l-.186-.002Z" clip-rule="evenodd"/>
        </svg>
       Googleでログイン
    </button>

    </div>
    
    <div class="mt-6 mb-8">
    <button class="relative z-10 bg-[#b621fe] border-none rounded-md text-white py-3 px-6 text-base font-medium focus:shadow-md w-1/2 transition duration-300 ease-in-out hover:bg-[#663dff] hover:text-white active:top-[2px] shadow-violet-300 shadow-xl focus:outline-none focus:ring focus:ring-gray-300 focus:ring-opacity-50">
    <%= link_to "ゲストユーザーでお試し", guest_login_path %>
    </button>
    </div>
  </div>  
</div>