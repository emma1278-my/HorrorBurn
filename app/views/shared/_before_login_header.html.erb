<header class="bg-transparent">
  <nav class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-4" aria-label="Global">
    <div class="flex lg:flex-1">
      <%= link_to top_index_path do %>
        <%= image_tag 'logo2.png', size: "200x200", class: "h-auto", alt: "" %>
      <% end %>
    </div>
    <div class="flex lg:hidden ">
      <button type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-white">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
    <div class="bg-opacity-0 hidden lg:flex lg:gap-x-12 kiwi-maru">
      <div class="relative">
        <%= link_to t('header.users_new'), new_user_path, class: "text-sm font-semibold leading-6 text-white hover:text-gray-900 font-Raleway" %>
        <div class="absolute -left-8 top-full z-10 mt-3 w-screen max-w-md overflow-hidden rounded-3xl bg-opacity-0 shadow-lg ring-1 ring-gray-900/5">      
        </div>
      </div>
      <div class="relative">
       <%= link_to t('header.login'), login_path, class: "text-sm font-semibold leading-6 text-white hover:text-gray-900 font-Raleway" %>
      </div>
      <div class="relative">
      <%= link_to t('header.metabolism_calculators'), new_metabolism_calculators_path, class: "text-sm font-semibold leading-6 text-white hover:text-gray-900 font-Raleway" %>
       </div>        
        <div class="absolute -left-8 top-full z-10 mt-3 w-screen max-w-md overflow-hidden rounded-3xl bg-opacity-0 shadow-lg ring-1 ring-gray-900/5"> 
    </div>
  </nav>
    <div class="lg:hidden" role="dialog" aria-modal="true">
    </div>
</header>