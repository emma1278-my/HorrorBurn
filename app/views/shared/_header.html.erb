<header class="bg-transparent">
  <nav class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-4" aria-label="Global">
    <div class="flex lg:flex-1">

    
      <%= link_to top_index_path do %>
        <%= image_tag 'logo2.png', size: "200x200", class: "h-auto", alt: "" %>
      <% end %>
    </div>

    <div class="flex lg:hidden ">
      <button type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-white">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
      
    </div>

    <div class="bg-opacity-0 hidden lg:flex lg:gap-x-12">
     <div class="relative mt-4">
      <%= link_to t('header.profile'), profile_path(current_user), class: "text-sm font-semibold leading-6 text-white hover:text-gray-900" %>
      <div class="absolute -left-8 top-full z-10 w-screen max-w-md overflow-hidden rounded-3xl bg-opacity-0 shadow-lg ring-1 ring-gray-900/5">        
        </div>
      </div>
      
      <%= link_to t('header.logout'), logout_path, data: { turbo_method: :delete }, class: "text-sm font-semibold leading-6 text-white hover:text-gray-900 mt-4" %>

    <div class="dropdown dropdown-end inline-block relative">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle icon">
        <div class="w-10 rounded-full">
        <%= image_tag(current_user.avatar_url, alt: "user icon", class: "w-10 rounded-full") %>
        </div>
      </div>
      <ul tabindex="0" class="dropdown-menu absolute hidden text-gray-700 pt-1">
        <li class="dropdown"><a class="rounded-t bg-gray-200 hover:bg-gray-400 py-2 px-4 block whitespace-no-wrap" href="#">One</a>
        <%= link_to (t 'defaults.logout'), logout_path, data: { turbo_method: :delete }, class: 'menu-item rounded-t bg-gray-200 hover:bg-gray-400 py-2 px-4 block whitespace-no-wrap' %>
        <%= link_to (t '.title'), top_index_path, class: 'menu-item rounded-t bg-gray-200 hover:bg-gray-400 py-2 px-4 block whitespace-no-wrap' %>
        <%= link_to (t 'profiles.show.title'), profile_path, class: 'menu-item rounded- bg-gray-200 hover:bg-gray-400 py-2 px-4 block whitespace-no-wrap' %>
        </li>
      </ul>
      </div>
    </div>
    
<style>
.dropdown:hover .dropdown-menu {
  display: block;
}
</style>
  </nav>
    <div class="lg:hidden" role="dialog" aria-modal="true">
    </div>
</header>
   