<section class="relative justify-center p-4 md:p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-center item-center ">
  <div class="container mx-auto px-4 py-12 sm:py-16 lg:py-20">
    <div class="text-center">
      <p class="text-3xl font-extrabold tracking-tight text-white lg:text-5xl mb-8"><%= t('.title') %></p>
    </div>
    <div class="max-w-md mx-auto">
      <%= form_tag(movies_search_path, method: :get, class: 'flex flex-col sm:flex-row items-center') do %>
        <div class="relative flex-grow mb-4 sm:mb-0 sm:mr-4">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
            </svg>
          </div>
          <%= search_field_tag :looking_for, nil, class: "block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: t('.movie_title'), required: true %>
        </div>
        <button type="submit" class="text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md mt-3 no-underline text-sm float-center shadow-lg shadow-violet-300"><%= t('.search') %></button>
      <% end %>
    </div>
    <%# 映画を表示 %>
    <% if params[:looking_for].present? %>
      <% movieinfo = JSON.parse((Tmdb::Search.movie(params[:looking_for])).to_json) %>
      <h2 class="text-white text-3xl no-underline"><%= t('.result') %> '<%= params[:looking_for] %>'</h2>
      <% i = 0 %>
      <div class="card-wrapper">
        <% while i < movieinfo['table']['results'].count %>
          <div class="card">
            <div class="card-upperinfo">
              <% if movieinfo['table']['results'][i]['table']['title'].present? %>
                <h3 class><%= link_to movieinfo['table']['results'][i]['table']['title'], movie_path(movieinfo['table']['results'][i]['table']['id']), class: "no-underline"%></h3>
              <% end %>
              <% if movieinfo['table']['results'][i]['table']['release_date'].present? %>
                <p class="release-date text-white"><%= t('.release_date') %>:  <%= movieinfo['table']['results'][i]['table']['release_date'] %></p>
              <% end %>
              <% if movieinfo['table']['results'][i]['table']['runtime'].present? %>
                <p class="runtime text-white"><%= movieinfo['table']['results'][i]['table']['runtime'] %>分</p>
              <% end %>
            </div>
            <% if movieinfo['table']['results'][i]['table']['poster_path'].present? %>
              <p><%= image_tag 'https://image.tmdb.org/t/p/w1280' + movieinfo['table']['results'][i]['table']['poster_path'], class: "card-img round-2xl", size: "200x300" %></p>
            <% end %>
          </div>
          <% i += 1 %>
        <% end %>
      </div>
  <%else%>
  </div>
 <%# 検索されていない時に表示 %>
    <h2 class="text-white text-3xl">今日の世界で人気なホラー映画</h2>
    <% movieinfo = Tmdb::Genre.movies(27) %>
    <% i = 0 %>
    <div class="card-wrapper ">
        <% while i < movieinfo.results.count %>
            <div class="card">
                <div class="card-upperinfo no-underline">
                    <%if movieinfo.results[i].title.present?%>
                        <h3 class="no-underline"><%= link_to movieinfo.results[i].title, movie_path(movieinfo.results[i].id)%></h3>
                    <%end%>

                    <% if movieinfo.results[i].release_date.present? %>
                        <p class="release-date text-white"><%= movieinfo.results[i].release_date %></p>
                    <%end%>
                </div>

                <% if movieinfo.results[i].poster_path.present? %>
                    <p><%= image_tag 'https://image.tmdb.org/t/p/w1280' + movieinfo.results[i].poster_path, class: "card-img", size: "200x300" %></p>
                <%end%>
            </div>

            <% i += 1%>
        <%end%>
    </div>
<%end%>
</section>
