<section class="relative justify-center p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300">
  <div class="container mx-auto px-4 py-12 sm:py-16 lg:py-20">
    <div class="text-center">
      <p class="text-3xl font-extrabold tracking-tight text-white lg:text-5xl mb-8">映 画 検 索</p>
    </div>
    <div class="max-w-md mx-auto">
      <%= form_tag(movies_search_path, method: :get) do %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
            </svg>
          </div>
          <%= search_field_tag :looking_for, nil, class: "block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "映画タイトルを入れてください", required: true %>
          <button type="submit" class="text-white absolute end-2.5 bottom-2.5 bg-violet-700 hover:bg-violet-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 dark:bg-violet-600 dark:hover:bg-gray-700 dark:focus:ring-blue-800">検 索</button>
        </div>
      <% end %>
    </div>
    <%# 映画を表示 %>
    <% if params[:looking_for].present? %>
      <% movieinfo = JSON.parse((Tmdb::Search.movie(params[:looking_for])).to_json) %>
      <h2 class="text-white text-3xl">"<%= params[:looking_for] %>"の検索結果</h2>
      <% i = 0 %>
      <div class="card-wrapper">
        <% while i < movieinfo['table']['results'].count %>
          <div class="card">
            <div class="card-upperinfo">
              <% if movieinfo['table']['results'][i]['table']['title'].present? %>
                <h3 class><%= link_to movieinfo['table']['results'][i]['table']['title'], movie_path(movieinfo['table']['results'][i]['table']['id']), class: "text-white no-underline"%></h3>
              <% end %>
              <% if movieinfo['table']['results'][i]['table']['release_date'].present? %>
                <p class="release-date text-white">公開日:  <%= movieinfo['table']['results'][i]['table']['release_date'] %></p>
              <% end %>
              <% if movieinfo['table']['results'][i]['table']['runtime'].present? %>
                <p class="runtime text-white"><%= movieinfo['table']['results'][i]['table']['runtime'] %>分</p>
              <% end %>
            </div>
            <% if movieinfo['table']['results'][i]['table']['poster_path'].present? %>
              <p><%= image_tag 'https://image.tmdb.org/t/p/w1280' + movieinfo['table']['results'][i]['table']['poster_path'], class: "card-img round-2xl", size: "200x300" %></p>
            <% end %>
          </div>
          <% i += 1 %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
