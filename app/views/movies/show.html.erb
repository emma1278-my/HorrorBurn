<section class="flex relative justify-center p-8 max-w-4xl mx-auto my-10 border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300">
  <div class="movie-detail text-white flex flex-col items-center">
 
    <div class="flex justify-center mb-4">
      <%= form_with model: @movie_history, local: true, url: movie_histories_path, method: :post, class: 'mr-4' do |form| %>
        <%= form.hidden_field :movie_id, value: @movie['id'] %>
        <%= form.hidden_field :title, value: @movie['title'] %>
        <%= form.hidden_field :runtime, value: @movie['runtime'] %>
        <%= form.submit t('.save'), class: "text-white bg-purple-600  hover:bg-purple-300  focus:bg-purple-700 focus:ring-offset-blue-200 focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-md px-4 py-2 no-underline shadow-lg shadow-violet-300" %>
      <% end %>
 
        <% consumed_calories = (@movie['runtime'].to_f * 1.26).round %>
          <%= link_to "https://twitter.com/intent/tweet?url=https://horrorburn.com&text=#{ERB::Util.url_encode(" #{@movie['title']}を視聴しました！ 約#{consumed_calories}kcal消費しました #HorrorBurn #ホラー映画 \n")}", target: "_blank", rel: "noopener", class: "text-white bg-black hover:bg-gray-700 focus:ring-gray-300 focus:ring-offset-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-md px-4 py-2 no-underline border-white shadow-lg shadow-violet-300" do %>
          <svg width="12" height="12" viewBox="0 0 1200 1227" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" fill="white"/>
          </svg>
        <% end %>
      </div>


    <p><%= @movie['title'] %></p>
    <p><%= t('.release_date') %> <%= @movie['release_date'] %></p>
    <p><%= t('.runtime') %> <%= @movie['runtime'] %><%= t('.min') %></p>
    <% if @movie['poster_path'] %>
        <p><%= image_tag 'https://image.tmdb.org/t/p/w200' + @movie['poster_path'],class: "card-size" %></p>
    <% end %>
    <p><%= @movie['overview'] %></p>
   
    <div class="text-center inline-flex items-center"> 
      <%= link_to t('.back_to_search'), movies_search_path(movie_id: @movie['id']), class: "text-blue-600 hover:underline ml-1 whitespace-nowrap text-center inline-flex items-center no-underline" %>
    </div>
</section>