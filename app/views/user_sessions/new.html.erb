<div class="flex justify-center">
<div class="w-full max-w-md p-6 mt-10 bg-transform rounded-lg shadow-lg shadow-violet-300">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
       <%= form_with(url: login_path, local: true) do |f| %>
        
            <div>
              <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                    <h1 class="text-xl text-center font-bold leading-tight tracking-tight text-white md:text-2xl">
                        ログイン
                    </h1>
                        <div>
                            <%= f.label :email, User.human_attribute_name(:email), class: "block mb-2 text-sm font-medium text-white" %>
                            <%= f.email_field :email, class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", placeholder: "example@domain.com" %>
                        </div>
                        <div>
                            <%= f.label :password, User.human_attribute_name(:password), class: "block mb-2 text-sm font-medium text-white" %>
                            
                            <%= f.password_field :password, placeholder: "••••••••", class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5", required: true %> 
                        </div>
                            <div class = "text-right"> 
                            <%= link_to 'passwordをお忘れの方はコチラ', new_password_reset_path, class: "text-xs text-white hover:underline" %>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-start">
                                
                               
                            </div>
                        </div>
                        <div class="flex item-center items-center justify-center">
                        <button class="text-center inline-flex items-center justify-center px-3 py-3 text-white  hover:bg-purple-300 focus:bg-purple-700 rounded-md mt-3 no-underline text-sm float-center shadow-violet-300-lg mb-8 bg-violet-500 w-1/2 shadow-violet-300 shadow-lg">
                          ログイン
                         </button>
                        </div>
                        <div class="relative flex items-center justify-center">
                        <hr class="flex-grow border-gray-400">
                        <span class="relative px-4 text-sm text-gray-400 bg-transparent">または</span>
                        <hr class="flex-grow border-gray-400">
                        </div>
                        <div class="relative flex items-center justify-center">
                         <button class="flex items-center justify-center w-full px-6 py-2 mx-9 text-sm font-medium text-white transition-colors duration-300 transform bg-blue-500 rounded-lg hover:bg-blue-400 focus:bg-blue-400 focus:outline-none shadow-blue-300 shadow-lg">
                          <%= link_to "Googleアカウントでログイン", auth_at_provider_path(provider: :google), class: "text-white no-underline inline-block" %>
                        </button>
                        </div>
                        <div class="relative flex items-center justify-center">
                        <p class="text-sm !mt-10 text-center text-white">アカウントがない方は <%= link_to 'こちら', new_user_path, class: "text-blue-600 hover:underline ml-1 whitespace-nowrap" %></p>
                        </div>
                </div>
            </div>
        </div>
    <% end %>
</div>

