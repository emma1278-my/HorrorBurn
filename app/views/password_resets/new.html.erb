<h1 class="mb-5 text-center text-white"><%= t('.title') %></h1>
<section class="max-w-4xl my-10 p-8 mx-auto border border-gray-400/30 backdrop-blur-lg shadow-xl rounded-2xl shadow-violet-300 text-white">
  <div class="my-10 mx-auto max-w-lg">
    <div class="text-center text-xl">
      <%= form_with url: password_resets_path do |f| %>
        <div class="mb-6">
          <%= f.label :email, class: "block text-lg font-medium text-white mb-2" %>
          <%= f.email_field :email, class: 'w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-violet-500' %>
        </div>
        <%= f.submit t('.submit'), class: "py-2 px-4 bg-violet-500 text-white rounded-lg hover:bg-violet-600 transition duration-200" %>
      <% end %>
    </div>
  </div>
</section>