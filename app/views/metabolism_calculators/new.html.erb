<p class="text-center text-lg text-white mt-6 ">
  <%= t('.explanation') %>
  <br><%= t('.question') %>
  <br><%= t('.follow') %>
</p>
<div class="flex items-center justify-center p-8 max-w-4xl mx-auto my-10 py-6 sm:py-12">
  <div class="max-w-[550px] mx-auto px-6 relative flex flex-col min-w-0 break-words border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300 font-Kiwi Maru text-white w-full">
    <%= form_with model: @user, url: metabolism_calculators_path, data: { turbo: false } do |form| %>
    
      <div class="text-left mt-12 ml-10">
      <%= form.label :current_weight, t('.current_weight'), class: "mb-3 block text-base font-medium" %>
        <%= form.number_field :current_weight, step: 0.1, min: 30.0, max: 150.0, id: "current_weight", class: "rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus:border-[#6A64F1] focus:shadow-md w-1/2" %>  kg
      </div>
        <div class="text-left mt-12 ml-10">
          <%= form.label :target_weight, t('.target_weight'), class: "mb-3 block text-base font-medium" %>
          <%= form.number_field :target_weight, step: 0.1, min: 30.0, max: 150.0, id: "target_weight", class: "rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus:border-[#6A64F1] focus:shadow-md w-1/2" %>  kg
        </div>
        <div class="-mx-3 flex flex-wrap">
          <div class="w-full px-3 sm:w-1/2">
            <div class="text-left mt-12 ml-10">
              <%= form.label :weight_achieved_date, t('.achieved_date'), class: "mb-3 block text-base font-medium" %>
              <%= form.date_field :weight_achieved_date, id: "weight_achieved_date", class: "rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus:border-[#6A64F1] focus:shadow-md w-1/2" %> <%= t('.until') %>
            </div>
          </div>
        </div>
      <div class="text-right mt-12 ml-10 mb-8">
        <%= form.submit t('.calculate'), class: 'float-center text-center inline-flex items-center justify-center px-3 py-3 text-white bg-purple-600 hover:bg-purple-300 focus:bg-purple-700 rounded-md mt-3 no-underline text-sm' %>
        </div>
       <% end %>
  </div>
  </div>
  <p class="text-center text-xs text-white mt-6 justify-center max-w-4xl mx-auto my-10 py-6 ">
  <%= t('.asterisk1') %>
 <br>
  <%= t('.asterisk2') %>
  <br>
  <%= t('.asterisk3') %>
 <br>
  <%= t('.asterisk4') %>
 <br>
  <%= t('.asterisk5') %>
<br>
  <%= t('.ref') %>
</p>

