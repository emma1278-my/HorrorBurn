<p class="text-center text-lg text-white mt-6">
  <%= t('.title') %>
</p>
<div class="flex flex-col justify-center items-center p-8 max-w-4xl mx-auto my-10 sm:p-12">
  <div class="max-w-[550px] mx-auto px-6 relative flex flex-col min-w-0 break-words border-gray-400/30 backdrop-blur-lg shadow-lg rounded-lg shadow-violet-300 font-Kiwi Maru text-white w-full">
    <form class="w-full text-center">
      <div class="mb-8">
        <div class="mt-12">
          <label for="target_weight" class="mb-3 block text-base font-medium">
            <span class="block text-base"><%= t('.target_weight') %> (<%= current_user.target_weight %> kg )<%= t('.for') %></span>
          </label>
        </div>
        <div class="mt-12 mb-8">
          <label for="remaining_weight" class="mb-3 block text-base font-medium">
            <%= t('.remaining_weight') %>
          </label>
          <div class="flex justify-center items-baseline">
            <span class="block text-2xl font-bold"><%= current_user.remaining_weight.round(2) %> kg</span>
            <p class="ml-8 mb-3 block text-sm font-medium"><%= t('.remaining_weight_round') %></p>
          </div>
        </div>

        <div class="mt-12">
          <label for="target_calorie" class="mb-3 block text-base font-medium">
            <%= t('.target_calorie') %>
          </label>
          <span class="block text-2xl font-bold"><%= current_user.target_calorie.round %> kcal</span>
        </div>
        <div class="mt-12 mb-8">
          <label for="target_weight" class="mb-3 block text-base font-medium">
            <%= t('.target_weight') %>
          </label>
          <div class="flex justify-center items-baseline">
            <span class="block text-2xl font-bold"><%= @remaining_runtime.round %> <%= t('.remaining_runtime_hours') %> </span>
            </div>
            <div class="ml-8 mb-5 text-sm font-medium ">
            <%= t('.remaining_runtime_round2') %>
            </div>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row justify-between items-center mt-12 ml-10 mb-8 my-6">
          <%= link_to t('.Recalculate'), new_metabolism_calculators_path, class: "btn btn-9 bg-violet-400 shadow-lg rounded-lg shadow-violet-300 mb-4 sm:mb-0" %>
          <%= link_to t('.back_to_dashboard'), dashboard_path(id: current_user.id), class: "btn btn-9 bg-violet-400 shadow-lg rounded-lg shadow-violet-300 mb-4 sm:mb-0" %>
        </div>
      </div>
    </form>
  </div>
</div>